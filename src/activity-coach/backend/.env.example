# 이 파일을 .env로 복사한 뒤 값을 입력하세요. 실제 키 파일은 공유하지 않습니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=2

# 패키지 내부 ../models의 로컬 모델. 다른 폴더를 참조할 필요가 없습니다.
COACH_EMBEDDING_ENABLED=true
COACH_RERANKER_ENABLED=true
# COACH_EMBEDDING_MODEL_PATH=../models/embedding/BGE-m3-ko
# COACH_RERANKER_MODEL_PATH=../models/reranker/KURE-Reranker-nano
COACH_DEVICE=auto
COACH_RERANK_CANDIDATES=20
COACH_DENSE_MIN_SIMILARITY=0.40
# 리랭커 점수(raw logit)가 이 값보다 낮은 후보는 근거로 쓰지 않습니다.
COACH_RERANK_MIN_SCORE=-2.0

COACH_DATA_DIR=data
COACH_INDEX_DIR=var/index
COACH_DATABASE_PATH=var/coach.sqlite
COACH_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
# 요청의 Host 헤더로 받아들일 이름(쉼표 구분). 기본값은 이 PC뿐입니다. 다른 주소로 서비스할 때만 바꿉니다.
# 포트는 적지 않습니다. IPv6는 [::1]처럼 대괄호째 적습니다. *를 넣으면 이 검사가 꺼집니다.
# COACH_ALLOWED_HOSTS=127.0.0.1,localhost
# Spring 백엔드가 POST /backend/coach/chat을 부를 때 X-Coach-Service-Token 헤더로 보내는 값입니다.
# 비워 두면 그 경로는 닫혀 있습니다(503). 32자 이상의 무작위 값을 넣고 백엔드와만 공유합니다.
# 32자보다 짧으면 서버가 시작하지 않습니다.
COACH_BACKEND_TOKEN=
