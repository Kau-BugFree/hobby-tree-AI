  "components": {
    "schemas": {
      "AnalysisResult": {
        "properties": {
          "recordId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Recordid"
          },
          "reportedDifficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EASY",
                  "APPROPRIATE",
                  "HARD"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporteddifficulty"
          },
          "aspects": {
            "items": {
              "$ref": "#/components/schemas/Aspect"
            },
            "type": "array",
            "title": "Aspects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recordId",
          "reportedDifficulty",
          "aspects"
        ],
        "title": "AnalysisResult"
      },
      "Aspect": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ENJOYMENT",
              "DIFFICULTY",
              "DURATION",
              "COST",
              "TOOLS",
              "COOKING_METHOD"
            ],
            "title": "Category"
          },
          "polarity": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "NEUTRAL",
              "MIXED"
            ],
            "title": "Polarity"
          },
          "signal": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PREFER_SHORTER",
                  "PREFER_LOWER_COST",
                  "PREFER_FEWER_TOOLS",
                  "PREFER_ONE_PAN"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Signal"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "polarity",
          "evidence"
        ],
        "title": "Aspect"
      },
      "AspectSummary": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ENJOYMENT",
              "DIFFICULTY",
              "DURATION",
              "COST",
              "TOOLS",
              "COOKING_METHOD"
            ],
            "title": "Category"
          },
          "polarity": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "NEUTRAL",
              "MIXED"
            ],
            "title": "Polarity"
          },
          "signal": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PREFER_SHORTER",
                  "PREFER_LOWER_COST",
                  "PREFER_FEWER_TOOLS",
                  "PREFER_ONE_PAN"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Signal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "polarity"
        ],
        "title": "AspectSummary"
      },
      "AuthenticationError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "AuthenticationError"
      },
      "Candidate": {
        "properties": {
          "activityId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Activityid"
          },
          "hobbyId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Hobbyid"
          },
          "stageId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Stageid"
          },
          "stageNumber": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Stagenumber"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title"
          },
          "published": {
            "type": "boolean",
            "title": "Published"
          },
          "startable": {
            "type": "boolean",
            "title": "Startable"
          },
          "durationMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationminutes"
          },
          "estimatedCost": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimatedcost"
          },
          "requiredToolCount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Requiredtoolcount"
          },
          "onePan": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onepan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activityId",
          "hobbyId",
          "stageId",
          "stageNumber",
          "title",
          "published",
          "startable"
        ],
        "title": "Candidate"
      },
      "Evidence": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "memo",
              "notDoneReason"
            ],
            "title": "Source"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start",
            "description": "Inclusive Unicode code point offset in source."
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End",
            "description": "Exclusive Unicode code point offset in source."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "text",
          "start",
          "end"
        ],
        "title": "Evidence"
      },
      "FeedbackRequest": {
        "properties": {
          "recordId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Recordid"
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "PARTIAL",
              "NOT_DONE"
            ],
            "title": "Status"
          },
          "satisfactionScore": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Satisfactionscore"
          },
          "perceivedDifficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EASY",
                  "APPROPRIATE",
                  "HARD"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Perceiveddifficulty"
          },
          "memo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Memo"
          },
          "notDoneReason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Notdonereason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recordId",
          "status"
        ],
        "title": "FeedbackRequest"
      },
      "FeedbackResult": {
        "properties": {
          "recordId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Recordid"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EASY",
                  "APPROPRIATE",
                  "HARD"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Difficulty"
          },
          "sentiment": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "MIXED",
              "UNKNOWN"
            ],
            "title": "Sentiment"
          },
          "signals": {
            "items": {
              "type": "string",
              "enum": [
                "PREFER_SHORTER",
                "PREFER_LOWER_COST",
                "PREFER_FEWER_TOOLS",
                "PREFER_ONE_PAN"
              ]
            },
            "type": "array",
            "title": "Signals"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recordId",
          "difficulty",
          "sentiment",
          "signals",
          "evidence"
        ],
        "title": "FeedbackResult"
      },
      "GroupPreference": {
        "properties": {
          "activityGroup": {
            "type": "string",
            "minLength": 1,
            "title": "Activitygroup",
            "description": "Stable BE catalog group shared by an activity record and candidate."
          },
          "category": {
            "type": "string",
            "enum": [
              "ENJOYMENT",
              "DIFFICULTY"
            ],
            "title": "Category"
          },
          "polarity": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE"
            ],
            "title": "Polarity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activityGroup",
          "category",
          "polarity"
        ],
        "title": "GroupPreference"
      },
      "GroupedHistoryRecord": {
        "properties": {
          "userHobbyId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Userhobbyid"
          },
          "recordId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Recordid"
          },
          "completedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
            "format": "date-time",
            "title": "Completedat"
          },
          "reportedDifficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EASY",
                  "APPROPRIATE",
                  "HARD"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporteddifficulty"
          },
          "aspects": {
            "items": {
              "$ref": "#/components/schemas/AspectSummary"
            },
            "type": "array",
            "title": "Aspects"
          },
          "activityGroup": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Stable BE catalog group shared by an activity record and candidate."
              },
              {
                "type": "null"
              }
            ],
            "title": "Activitygroup"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userHobbyId",
          "recordId",
          "completedAt",
          "aspects"
        ],
        "title": "GroupedHistoryRecord"
      },
      "GroupedHistoryRequest": {
        "properties": {
          "userHobbyId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Userhobbyid"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/GroupedHistoryRecord"
            },
            "type": "array",
            "title": "Records",
            "description": "Current, nondeleted records of one tree with optional catalog group keys."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userHobbyId",
          "records"
        ],
        "title": "GroupedHistoryRequest"
      },
      "GroupedProfileResult": {
        "properties": {
          "userHobbyId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Userhobbyid"
          },
          "recordCount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Recordcount"
          },
          "preferredDifficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EASY",
                  "APPROPRIATE",
                  "HARD"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferreddifficulty"
          },
          "signals": {
            "items": {
              "type": "string",
              "enum": [
                "PREFER_SHORTER",
                "PREFER_LOWER_COST",
                "PREFER_FEWER_TOOLS",
                "PREFER_ONE_PAN"
              ]
            },
            "type": "array",
            "title": "Signals"
          },
          "groupPreferences": {
            "items": {
              "$ref": "#/components/schemas/GroupPreference"
            },
            "type": "array",
            "title": "Grouppreferences"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userHobbyId",
          "recordCount",
          "preferredDifficulty",
          "signals",
          "groupPreferences"
        ],
        "title": "GroupedProfileResult"
      },
      "HistoryRecord": {
        "properties": {
          "userHobbyId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Userhobbyid"
          },
          "recordId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Recordid"
          },
          "completedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
            "format": "date-time",
            "title": "Completedat"
          },
          "reportedDifficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EASY",
                  "APPROPRIATE",
                  "HARD"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporteddifficulty"
          },
          "aspects": {
            "items": {
              "$ref": "#/components/schemas/AspectSummary"
            },
            "type": "array",
            "title": "Aspects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userHobbyId",
          "recordId",
          "completedAt",
          "aspects"
        ],
        "title": "HistoryRecord"
      },
      "HistoryRequest": {
        "properties": {
          "userHobbyId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Userhobbyid"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/HistoryRecord"
            },
            "type": "array",
            "title": "Records",
            "description": "Current, nondeleted records of a single user's hobby tree."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userHobbyId",
          "records"
        ],
        "title": "HistoryRequest"
      },
      "HomeCandidate": {
        "properties": {
          "activityId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Activityid"
          },
          "hobbyId": {
