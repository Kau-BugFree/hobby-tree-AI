# 이 파일을 .env로 복사한 뒤 값을 입력하세요. 실제 키 파일은 공유하지 않습니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=2

# 로컬 모델(산학프로젝트/rag_test/models). 비우면 기본 경로를 사용합니다.
COACH_EMBEDDING_ENABLED=true
COACH_RERANKER_ENABLED=true
# COACH_EMBEDDING_MODEL_PATH=C:/Users/.../rag_test/models/embedding/BGE-m3-ko
# COACH_RERANKER_MODEL_PATH=C:/Users/.../rag_test/models/reranker/KURE-Reranker-nano
COACH_DEVICE=auto
COACH_RERANK_CANDIDATES=20
COACH_DENSE_MIN_SIMILARITY=0.40
# 리랭커 점수(raw logit)가 이 값보다 낮은 후보는 근거로 쓰지 않습니다.
COACH_RERANK_MIN_SCORE=-2.0

COACH_DATA_DIR=data
COACH_INDEX_DIR=var/index
COACH_DATABASE_PATH=var/coach.sqlite
COACH_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
