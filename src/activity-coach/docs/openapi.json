          "session_id": "세션 생성 응답의 session_id",
          "request_id": "demo-1",
          "message": "오늘 20분 안에 할 요리 활동 추천해줘"
         }
        },
        "select": {
         "summary": "직전 추천의 두 번째 선택",
         "value": {
          "session_id": "같은 session_id",
          "request_id": "demo-2",
          "message": "두 번째 걸로 할게"
         }
        },
        "explain": {
         "summary": "근거 기반 설명 (생성·인용·의미 점검)",
         "value": {
          "session_id": "같은 session_id",
          "request_id": "demo-3",
          "message": "현재 단계를 쉽게 설명해줘"
         }
        },
        "complete": {
         "summary": "명시적 완료 선언과 기록",
         "value": {
          "session_id": "같은 session_id",
          "request_id": "demo-4",
          "message": "완료했어"
         }
        },
